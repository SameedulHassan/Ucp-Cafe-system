@model IEnumerable<Review>
@{
    ViewData["Title"] = "Manage Reviews";
    var items = ViewBag.Items as Dictionary<int, string> ?? new Dictionary<int, string>();
    var users = ViewBag.Users as Dictionary<int, string> ?? new Dictionary<int, string>();
}
<div class="container py-5">
    <div class="admin-title-row"><div><span class="eyebrow">ADMIN</span><h1>Reviews</h1></div><a class="btn btn-outline-dark" asp-action="Dashboard">← Dashboard</a></div>
    <div class="row g-3">
        @foreach (var review in Model)
        {
            <div class="col-lg-6">
                <div class="content-card">
                    <div class="d-flex justify-content-between">
                        <div><strong>@(users.ContainsKey(review.UserId) ? users[review.UserId] : "User")</strong><div class="small text-muted">@(items.ContainsKey(review.CafeItemId) ? items[review.CafeItemId] : "Item")</div></div>
                        <span class="rating">@review.Rating / 5</span>
                    </div>
                    <p class="mt-3 mb-2">@review.Comment</p>
                    <small class="text-muted">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                    <form method="post" asp-action="DeleteReview" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@review.Id" />
                        <button class="btn btn-sm btn-outline-danger">Delete Review</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
