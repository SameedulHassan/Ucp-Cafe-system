@model Deal
@{ ViewData["Title"] = "Edit Deal"; var items = ViewBag.Items as List<CafeItem> ?? new List<CafeItem>(); var selected = ViewBag.Selected as Dictionary<int,int> ?? new Dictionary<int,int>(); }
<div class="admin-shell"><div class="container py-5"><div class="form-page"><span class="eyebrow">ADMIN / DEALS</span><h1>Edit deal</h1><p class="text-muted">Update the existing deal instead of deleting and recreating it.</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}
<form method="post" enctype="multipart/form-data" asp-action="EditDeal">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/>
<div class="mb-3"><label class="form-label">Deal name</label><input class="form-control" name="name" value="@Model.Name" required/></div>
<div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3">@Model.Description</textarea></div>
<div class="row g-3"><div class="col-md-6"><label class="form-label">Deal price (Rs.)</label><input class="form-control" name="dealPrice" type="number" min="1" step="0.01" value="@Model.DealPrice" required/></div><div class="col-md-6"><label class="form-label">Replace image</label><input class="form-control" name="image" type="file" accept=".jpg,.jpeg,.png,.webp,.jfif"/></div></div>
<h5 class="mt-4 mb-3">Items in this deal</h5><div class="deal-builder">@foreach(var item in items){var isSelected=selected.ContainsKey(item.Id);var qty=isSelected?selected[item.Id]:1;<label class="deal-builder-row"><span class="d-flex align-items-center gap-3"><input class="form-check-input" type="checkbox" name="itemIds" value="@item.Id" @(isSelected?"checked":"")/><span><strong>@item.Name</strong><small>@item.Category · Rs. @item.Price.ToString("N0")</small></span></span><input class="form-control deal-qty" type="number" min="1" value="@qty" name="quantities[@item.Id]"/></label>}</div>
<div class="form-check my-4"><input class="form-check-input" type="checkbox" name="isActive" value="true" @(Model.IsActive?"checked":"")/><label class="form-check-label">Show this deal on customer home page</label></div><button class="btn btn-gold btn-lg">Save Changes</button><a class="btn btn-outline-secondary btn-lg" asp-action="Deals">Cancel</a></form></div></div></div>
