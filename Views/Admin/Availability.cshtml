@{
    ViewData["Title"] = "Daily Availability";
    var item = ViewBag.Item as CafeItem;
    var date = (DateTime)ViewBag.Date;
    var current = (bool)ViewBag.Current;
}
<div class="container py-5">
    <div class="form-page">
        <span class="eyebrow">ADMIN / MENU</span>
        <h1>Daily availability</h1>
        <p class="text-muted"><strong>@item?.Name</strong> — set whether customers can order it on a particular date.</p>
        <form method="post" asp-action="Availability">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item?.Id" />
            <div class="mb-3"><label class="form-label">Date</label><input class="form-control" type="date" name="date" value="@date.ToString("yyyy-MM-dd")" required /></div>
            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isAvailable" value="true" @(current ? "checked" : "") />
                <label class="form-check-label">Available on this date</label>
            </div>
            <button class="btn btn-gold">Save Availability</button>
            <a class="btn btn-outline-secondary" asp-action="Items">Cancel</a>
        </form>
    </div>
</div>
