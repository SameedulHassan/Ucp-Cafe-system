@model IEnumerable<User>
@{
    ViewData["Title"] = "Manage Users";
}
<div class="container py-5">
    <div class="admin-title-row"><div><span class="eyebrow">ADMIN</span><h1>Users</h1></div><a class="btn btn-outline-dark" asp-action="Dashboard">← Dashboard</a></div>
    <div class="table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>#@user.Id</td><td><strong>@user.Name</strong></td><td>@user.Email</td>
                        <td><span class="role-pill @(user.Role == "Admin" ? "admin" : "")">@user.Role</span></td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-action="EditUser" asp-route-id="@user.Id">Edit</a>
                            @if (Context.Session.GetInt32("UserId") != user.Id)
                            {
                                <form method="post" asp-action="DeleteUser" class="d-inline" onsubmit="return confirm('Delete this user?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
