@model IEnumerable<CafeItem>
@{
    ViewData["Title"] = "Menu";
    var unavailable = ViewBag.UnavailableIds as HashSet<int> ?? new HashSet<int>();
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var loggedIn = Context.Session.GetInt32("UserId") != null;
}
<section class="page-header"><div class="container"><span class="eyebrow">UCP FOOD CORNER</span><h1>Full Menu</h1><p>Choose an item, set quantity, add it to your cart or order it immediately.</p></div></section>
<section class="container py-4"><div class="order-help-card"><div><strong>How to order:</strong> choose quantity, then use <b>🛒 Add to Cart</b> or <b>⚡ Order Now</b>. Use <b>👁 View Item</b> to read or write reviews.</div><a class="btn btn-dark" asp-action="Cart">🛒 Open Cart</a></div></section>
<section class="container py-2"><form class="filter-bar mb-5" method="get" asp-action="Index"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search food or drinks..." /><select class="form-select" name="category"><option value="">All categories</option>@foreach(var c in ViewBag.Categories){<option value="@c" selected="@(ViewBag.Category == c ? "selected" : null)">@c</option>}</select><button class="btn btn-dark">Search</button></form>
@if(!Model.Any()){<div class="alert alert-info text-center">No menu items matched your search.</div>}
<div class="row g-4">@foreach(var item in Model){var off=unavailable.Contains(item.Id);var rs=reviews.Where(x=>x.CafeItemId==item.Id).ToList();var avg=rs.Any()?rs.Average(x=>x.Rating):0;
<div class="col-md-6 col-lg-4"><div class="item-card h-100"><div class="image-wrap">@if(!string.IsNullOrWhiteSpace(item.ImagePath)){<img src="@item.ImagePath" alt="@item.Name" class="item-image"/>}else{<div class="item-placeholder">🍽️</div>}<span class="availability-badge @(off?"off":"on")">@(off?"Unavailable today":"Available today")</span></div><div class="p-3 d-flex flex-column h-100"><div class="d-flex justify-content-between gap-2"><h5>@item.Name</h5><strong class="price">Rs. @item.Price.ToString("N0")</strong></div><span class="category-label">@item.Category</span><p class="text-muted mt-2">@item.Description</p><div class="rating mb-3">★ @(avg==0?"New":avg.ToString("0.0")) <small>(@rs.Count reviews)</small></div>
<div class="mt-auto">
<a class="btn btn-outline-dark w-100 mb-2" asp-action="Details" asp-route-id="@item.Id">👁 View Item & Reviews</a>
@if(loggedIn){<div class="order-box"><div class="row g-2 align-items-center"><div class="col-4"><label class="small fw-semibold">Qty</label><input id="qty-@item.Id" class="form-control" type="number" min="1" value="1" @(off?"disabled":"") /></div><div class="col-8"><div class="small text-muted">Price</div><div class="fw-bold">Rs. @item.Price.ToString("N0") each</div></div></div><form method="post" asp-action="AddToCart" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" id="cartqty-@item.Id" name="quantity" value="1"/><button type="submit" class="btn btn-dark w-100" @(off?"disabled":"") onclick="document.getElementById('cartqty-@item.Id').value=document.getElementById('qty-@item.Id').value">🛒 ADD TO CART</button></form><form method="post" asp-action="BuyNow" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" id="buyqty-@item.Id" name="quantity" value="1"/><button type="submit" class="btn btn-gold w-100" @(off?"disabled":"") onclick="document.getElementById('buyqty-@item.Id').value=document.getElementById('qty-@item.Id').value">⚡ ORDER NOW</button></form></div>}else{<a class="btn btn-dark w-100" asp-controller="Login" asp-action="SignIn">🔐 SIGN IN TO ORDER</a>}
<a class="btn btn-sm btn-link text-dark w-100 mt-1" asp-action="Details" asp-route-id="@item.Id" asp-fragment="review">★ Write a Review</a></div></div></div></div>
}</div></section>
