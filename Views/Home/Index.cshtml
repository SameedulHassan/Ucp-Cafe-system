@model IEnumerable<Deal>
@{ViewData["Title"]="Home";var dealItems=ViewBag.DealItems as List<DealItem>??new();var cafeItems=ViewBag.CafeItems as Dictionary<int,CafeItem>??new();var loggedIn=Context.Session.GetInt32("UserId")!=null;var userName=Context.Session.GetString("UserName")??"Customer";}
<section class="hero-section"><div class="container hero-content"><div class="hero-copy"><span class="eyebrow">UCP FOOD CORNER</span>@if(loggedIn){<h1>Welcome,<br/><span>@userName!</span></h1><p>Your account is ready. Scroll down to see today's deals.</p><a class="hero-down" href="#deals">↓ <span>See today's deals</span></a>}else{<h1>Good food.<br/><span>Good vibes.</span></h1><p>Discover today's special deals at UCP Food Corner. Sign in when you're ready to order.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-gold btn-lg" href="#deals">Today's Deals</a><a class="btn btn-outline-light btn-lg" asp-controller="Login" asp-action="SignIn">Sign In</a></div>}</div></div></section>
<section class="container py-5" id="deals"><div class="section-heading"><span>TODAY'S SPECIALS</span><h2>Campus Deals</h2><p>Deals can be viewed, added to your cart, or ordered immediately.</p></div>@if(!Model.Any()){<div class="empty-state"><div class="empty-icon">🍔</div><h3>No deals are available right now</h3><p class="text-muted">Check back later for today's offers.</p></div>}else{<div class="row g-4">@foreach(var deal in Model){var components=dealItems.Where(x=>x.DealId==deal.Id).ToList();var regularTotal=components.Sum(x=>cafeItems.ContainsKey(x.CafeItemId)?cafeItems[x.CafeItemId].Price*x.Quantity:0);var saving=Math.Max(0,regularTotal-deal.DealPrice);<div class="col-md-6 col-xl-4"><div class="deal-card h-100">@if(!string.IsNullOrWhiteSpace(deal.ImagePath)){<img src="@deal.ImagePath" alt="@deal.Name" class="deal-image"/>}else{<div class="deal-placeholder">🎁</div>}<div class="p-4 d-flex flex-column h-100"><span class="deal-badge">SPECIAL DEAL</span><h3 class="mt-2">@deal.Name</h3><p class="text-muted">@deal.Description</p><div class="deal-items-list mb-3">@foreach(var c in components){if(cafeItems.ContainsKey(c.CafeItemId)){<span>@c.Quantity × @cafeItems[c.CafeItemId].Name</span>}}</div><div class="deal-price-box mb-3"><div class="text-muted small">Regular total: <s>Rs. @regularTotal.ToString("N0")</s></div><div class="price-large">DEAL PRICE: Rs. @deal.DealPrice.ToString("N0")</div>@if(saving>0){<div class="text-success fw-bold">You save Rs. @saving.ToString("N0")</div>}</div><div class="mt-auto d-grid gap-2"><a class="btn btn-outline-dark btn-lg" asp-controller="Cafe" asp-action="DealDetails" asp-route-id="@deal.Id">👁 VIEW DEAL</a>@if(loggedIn){<div class="deal-order-box"><label class="small fw-semibold">Quantity</label><input id="dealqty-@deal.Id" class="form-control" type="number" min="1" value="1"/></div><form method="post" asp-controller="Cafe" asp-action="AddDealToCart">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@deal.Id"/><input type="hidden" id="dealcartqty-@deal.Id" name="quantity" value="1"/><button class="btn btn-dark btn-lg w-100" onclick="document.getElementById('dealcartqty-@deal.Id').value=document.getElementById('dealqty-@deal.Id').value">🛒 ADD DEAL TO CART</button></form><form method="post" asp-controller="Cafe" asp-action="BuyDealNow">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@deal.Id"/><input type="hidden" id="dealbuyqty-@deal.Id" name="quantity" value="1"/><button class="btn btn-gold btn-lg w-100" onclick="document.getElementById('dealbuyqty-@deal.Id').value=document.getElementById('dealqty-@deal.Id').value">⚡ ORDER DEAL NOW</button></form>}else{<a class="btn btn-dark btn-lg" asp-controller="Login" asp-action="SignIn">🔐 SIGN IN TO ORDER DEAL</a>}</div></div></div></div>}}</div>}
</section><section class="campus-banner"><div class="container"><div class="banner-card"><div><span class="eyebrow">FULL MENU</span><h2>Want something else?</h2><p>Browse every item, check availability, read reviews and order individual items.</p></div><a class="btn btn-gold" asp-controller="Cafe" asp-action="Index">Explore Full Menu</a></div></div></section>
